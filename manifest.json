{
  "manifest_version": 3,
  "name": "OfferGET 简历助手",
  "version": "1.1.0",
  "description": "用本地维护的简历信息，快速完成网申表单填写。",
  "permissions": ["storage", "activeTab", "scripting", "sidePanel", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "打开 OfferGET 侧边栏"
  },
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "options_page": "profile.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["profile-model.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["profile.json"],
      "matches": ["<all_urls>"]
    }
  ]
}
